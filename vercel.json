{
  "installCommand": "yarn install --frozen-lockfile",
  "functions": {
    "pages/api/refresh-metrics/predict-roi-distribution.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "pages/api/refresh-metrics/predict.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "pages/api/refresh-metrics/agent-economies.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "pages/api/refresh-metrics/other.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "pages/api/refresh-metrics/main.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "pages/api/refresh-metrics/predict-tool-accuracy.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "pages/api/refresh-metrics/explorer.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "pages/api/refresh-metrics/staking-apr.ts": {
      "maxDuration": 300,
      "memory": 512
    }
  },
  "crons": [
    {
      "path": "/api/refresh-metrics/main",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/refresh-metrics/predict",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/refresh-metrics/agent-economies",
      "schedule": "40 */2 * * *"
    },
    {
      "path": "/api/refresh-metrics/other",
      "schedule": "10 */6 * * *"
    },
    {
      "path": "/api/refresh-metrics/predict-roi-distribution?agent=omenstrat",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/refresh-metrics/predict-roi-distribution?agent=polystrat",
      "schedule": "5 4 * * *"
    },
    {
      "path": "/api/refresh-metrics/predict-tool-accuracy",
      "schedule": "5 5 * * *"
    },
    {
      "path": "/api/refresh-metrics/explorer",
      "schedule": "50 6 * * *"
    },
    {
      "path": "/api/refresh-metrics/staking-apr",
      "schedule": "30 1 * * *"
    }
  ]
}
